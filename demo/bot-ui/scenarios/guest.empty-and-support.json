{
  "scenarioId": "guest.empty-and-support",
  "title": "No order yet, the FAQ, then a message to a person",
  "locale": "uk",
  "context": {
    "chat": "private",
    "delivery.method": "pickup"
  },
  "data": {
    "cart.summary": "Флет вайт M, вівсяне молоко · Вершковий круасан",
    "cart.total": "6,30 €",
    "cart.drink": "Флет вайт M, вівсяне молоко",
    "cart.drink_price": "3,90 €",
    "cart.pastry": "Вершковий круасан",
    "cart.pastry_price": "2,40 €",
    "order.no": "218",
    "pickup.time": "8:45",
    "pickup.unix": "1794737100",
    "order.status_text": "brewing",
    "loyalty.stamps": "7",
    "loyalty.left": "3"
  },
  "steps": [
    {
      "command": "start"
    },
    {
      "press": "order"
    },
    {
      "expect": {
        "screen": "order.none"
      }
    },
    {
      "press": "back"
    },
    {
      "press": "help"
    },
    {
      "expect": {
        "screen": "support.faq"
      }
    },
    {
      "press": "write"
    },
    {
      "expect": {
        "screen": "support.start"
      }
    },
    {
      "text": "Забули додати кришку"
    },
    {
      "expect": {
        "screen": "support.sent"
      }
    },
    {
      "press": "menu"
    },
    {
      "expect": {
        "screen": "entry.start"
      }
    }
  ]
}
