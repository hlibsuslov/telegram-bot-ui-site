{
  "scenarioId": "order.happy",
  "title": "Coffee from the menu, a pastry and a note, paid on the first try, receipt and pickup",
  "locale": "en",
  "context": {
    "chat": "private",
    "delivery.method": "pickup"
  },
  "data": {
    "cart.summary": "Flat white M, oat milk · Butter croissant",
    "cart.total": "€6.30",
    "cart.drink": "Flat white M, oat milk",
    "cart.drink_price": "€3.90",
    "cart.pastry": "Butter croissant",
    "cart.pastry_price": "€2.40",
    "order.no": "218",
    "pickup.time": "8:45",
    "pickup.unix": "1794737100",
    "order.status_text": "brewing",
    "loyalty.stamps": "7",
    "loyalty.left": "3"
  },
  "handlers": {
    "checkout.pay": [
      "ok"
    ]
  },
  "steps": [
    {
      "command": "start"
    },
    {
      "expect": {
        "screen": "entry.start"
      }
    },
    {
      "press": "menu"
    },
    {
      "press": "coffee"
    },
    {
      "expect": {
        "screen": "menu.coffee"
      }
    },
    {
      "press": "flat"
    },
    {
      "press": "m"
    },
    {
      "press": "oat"
    },
    {
      "expect": {
        "screen": "checkout.review"
      }
    },
    {
      "press": "pastry"
    },
    {
      "expect": {
        "screen": "menu.bakery"
      }
    },
    {
      "press": "croissant"
    },
    {
      "press": "checkout"
    },
    {
      "expect": {
        "screen": "checkout.review"
      }
    },
    {
      "press": "note"
    },
    {
      "text": "Extra hot, please"
    },
    {
      "expect": {
        "screen": "checkout.review"
      }
    },
    {
      "press": "pay"
    },
    {
      "expect": {
        "screen": "order.placed"
      }
    },
    {
      "press": "receipt"
    },
    {
      "expect": {
        "screen": "order.receipt",
        "contains": "218"
      }
    },
    {
      "press": "track"
    },
    {
      "expect": {
        "screen": "order.status"
      }
    },
    {
      "press": "route"
    },
    {
      "expect": {
        "screen": "order.pickup"
      }
    }
  ]
}
