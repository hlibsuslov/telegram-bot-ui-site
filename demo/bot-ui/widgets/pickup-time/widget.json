      "d0": {
        "label": "First day",
        "type": "time",
        "help": "Any moment of the first day in the strip."
      },
      "b": {
        "label": "First slot",
        "type": "number",
        "help": "Minutes after midnight, e.g. 450 for 7:30."
      },
      "sp": {
        "label": "Slot step",
        "type": "number",
        "help": "Minutes between slots."
      },
      "m": {
        "label": "Free slots",
        "advanced": true,
        "help": "One hex string per day: bit i set = slot i is free."
      },
      "sel": {
        "label": "Chosen slot",
        "type": "text",
        "help": "<day>:<HHMM>, not yet confirmed."
      },
      "bk": {
        "label": "Booked slot",
        "type": "text",
        "help": "<day>:<HHMM>"
      },
      "r": {
        "label": "Data version",
        "type": "number",
        "advanced": true,
        "help": "Goes up with every update so the widget ignores older data. The bot sets it."
      }
    }
  },
