{
  "id": "entry.start",
  "title": "Start",
  "kind": "entry",
  "audience": "private",
  "message": {
    "id": "main",
    "format": "regular.html",
    "text": {
      "en": "<b>Brewline</b> ☕\nOrder ahead and skip the line. Your usual is two taps away.",
      "ru": "<b>Brewline</b> ☕\nЗакажите заранее и не стойте в очереди. Ваш обычный заказ в двух нажатиях.",
      "uk": "<b>Brewline</b> ☕\nЗамовте заздалегідь і не стійте в черзі. Ваше звичне замовлення за два натискання."
    }
  },
  "keyboard": {
    "type": "inline",
    "rows": [
      [
        "menu"
      ],
      [
        "usual"
      ],
      [
        "order",
        "card"
      ],
      [
        "help"
      ]
    ]
  },
  "actions": {
    "menu": {
      "label": {
        "en": "☕ Menu",
        "ru": "☕ Меню",
        "uk": "☕ Меню"
      },
      "type": "navigate",
      "to": "menu.categories",
      "presentation": "edit",
      "style": "primary"
    },
    "usual": {
      "label": {
        "en": "Repeat my usual",
        "ru": "Повторить обычный",
        "uk": "Повторити звичне"
      },
      "type": "navigate",
      "to": "checkout.review",
      "presentation": "edit",
      "set": {
        "drink": "flat_white",
        "cup.size": "m",
        "milk": "oat"
      }
    },
    "order": {
      "label": {
        "en": "📦 My order",
        "ru": "📦 Мой заказ",
        "uk": "📦 Моє замовлення"
      },
      "type": "navigate",
      "presentation": "edit",
      "rule": {
        "when": {
          "field": "order.active",
          "eq": true
        },
        "match": "order.status",
        "otherwise": "order.none"
      }
    },
    "card": {
      "label": {
        "en": "⭐ Loyalty card",
        "ru": "⭐ Карта гостя",
        "uk": "⭐ Картка гостя"
      },
      "type": "navigate",
      "to": "loyalty.card",
      "presentation": "edit"
    },
    "help": {
      "label": {
        "en": "💬 Support",
        "ru": "💬 Поддержка",
        "uk": "💬 Підтримка"
      },
      "type": "navigate",
      "to": "support.start",
      "presentation": "send"
    }
  }
}
