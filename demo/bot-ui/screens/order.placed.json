{
  "id": "order.placed",
  "title": "Order placed",
  "kind": "result",
  "audience": "private",
  "message": {
    "id": "main",
    "format": "regular.html",
    "text": {
      "en": "<tg-emoji emoji-id=\"5774022692642492953\">✅</tg-emoji> <b>Order #{order.no} is in</b>\nIt will be ready at <tg-time unix=\"{pickup.unix}\" format=\"t\">{pickup.time}</tg-time>. We'll message you the moment it is.",
      "ru": "<tg-emoji emoji-id=\"5774022692642492953\">✅</tg-emoji> <b>Заказ #{order.no} принят</b>\nБудет готов к <tg-time unix=\"{pickup.unix}\" format=\"t\">{pickup.time}</tg-time>. Напишем, как только он будет готов.",
      "uk": "<tg-emoji emoji-id=\"5774022692642492953\">✅</tg-emoji> <b>Замовлення #{order.no} прийнято</b>\nБуде готове о <tg-time unix=\"{pickup.unix}\" format=\"t\">{pickup.time}</tg-time>. Напишемо, щойно воно буде готове."
    }
  },
  "keyboard": {
    "type": "inline",
    "rows": [
      [
        "track"
      ],
      [
        "receipt",
        "time"
      ],
      [
        "menu"
      ]
    ]
  },
  "actions": {
    "track": {
      "label": {
        "en": "Track order",
        "ru": "Следить за заказом",
        "uk": "Стежити за замовленням"
      },
      "type": "navigate",
      "to": "order.status",
      "presentation": "send",
      "style": "primary",
      "set": {
        "order.active": true
      }
    },
    "receipt": {
      "label": {
        "en": "Receipt",
        "ru": "Чек",
        "uk": "Чек"
      },
      "type": "navigate",
      "to": "order.receipt",
      "presentation": "send"
    },
    "time": {
      "label": {
        "en": "Change time",
        "ru": "Изменить время",
        "uk": "Змінити час"
      },
      "type": "navigate",
      "to": "order.time",
      "presentation": "send"
    },
    "menu": {
      "label": {
        "en": "Main menu",
        "ru": "В меню",
        "uk": "У меню"
      },
      "type": "navigate",
      "to": "entry.start",
      "presentation": "edit",
      "set": {
        "order.active": true
      }
    }
  }
}
